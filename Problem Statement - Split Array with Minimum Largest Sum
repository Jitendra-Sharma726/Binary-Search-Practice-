# Python Solution

```python
def can_split(nums, k, max_sum):
    parts = 1
    current_sum = 0

    for num in nums:
        if current_sum + num <= max_sum:
            current_sum += num
        else:
            parts += 1
            current_sum = num

    return parts <= k


def splitArray(nums, k):
    low = max(nums)
    high = sum(nums)

    while low < high:
        mid = (low + high) // 2

        if can_split(nums, k, mid):
            # mid is possible, try smaller
            high = mid
        else:
            # mid is too small
            low = mid + 1

    return low


# Input
N, K = map(int, input().split())
nums = list(map(int, input().split()))

# Output
print(splitArray(nums, K))
```

