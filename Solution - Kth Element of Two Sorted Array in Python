import sys

def findKthElement(a, b, k):
    m = len(a)
    n = len(b)
    
    # Always ensure array 'a' is the smaller array to minimize binary search range
    if m > n:
        return findKthElement(b, a, k)
        
    # Set the safe boundaries for binary search
    low = max(0, k - n)
    high = min(m, k)
    
    while low <= high:
        mid1 = (low + high) // 2
        mid2 = k - mid1
        
        # Elements near the partition edge in array A
        l1 = a[mid1 - 1] if mid1 > 0 else float('-inf')
        r1 = a[mid1] if mid1 < m else float('inf')
        
        # Elements near the partition edge in array B
        l2 = b[mid2 - 1] if mid2 > 0 else float('-inf')
        r2 = b[mid2] if mid2 < n else float('inf')
        
        # Valid partition check
        if l1 <= r2 and l2 <= r1:
            return max(l1, l2)
        elif l1 > r2:
            # We took too many elements from a, move left
            high = mid1 - 1
        else:
            # We took too few elements from a, move right
            low = mid1 + 1
            
    return -1

def solve():
    # Fast I/O to read and parse inputs efficiently
    input_data = sys.stdin.read().split()
    if not input_data:
        return
        
    iterator = iter(input_data)
    
    m = int(next(iterator))
    n = int(next(iterator))
    
    a = [int(next(iterator)) for _ in range(m)]
    b = [int(next(iterator)) for _ in range(n)]
    
    k = int(next(iterator))
    
    result = findKthElement(a, b, k)
    print(result)

if __name__ == '__main__':
    solve()
