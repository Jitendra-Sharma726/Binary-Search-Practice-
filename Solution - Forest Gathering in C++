#include <bits/stdc++.h>
using namespace std;
#define int long long 
int32_t main() {
	// your code goes here
	ios::sync_with_stdio(0);
	cin.tie(0);
	cout.tie(0);
	
	int l = 0 ;
	int h = pow(10LL,18);
	int N , W , L ;
	cin>>N>>W>>L ;
	
	vector< array< int , 2 > > A( N );
	
	for( auto &x : A )
	cin>>x[0]>>x[1];
	
	array<int, 2> search_space = {0, pow(10LL, 18)};
	auto ok = [&]( int m )->int
	{
	     int s = 0 ;
	     
	     for( int i = 0 ; i < N ; i++ )
	     {
	         if( A[i][0] + m*A[i][1] >= L )
	            s += A[i][0] + m*A[i][1] ;
	         
	         if( s >= W )
	            return 1 ;
	     }
	     
	     return s >= W ;
	     
	};
	
	auto clean = [&]( int k )->int
	{
	    for( int m = k-1 ; m <= k+1 ; m++ )
    	    if( m >= search_space[0] && m <= search_space[1] && ok(m) )
    	        return m;
	    return k;
	};
	
	while(l < h)
	{
	    int m = (l+h)>>1 ;
	    
	    if(ok(m))
	        h = m-1;
	    else
	        l = m+1;
	}
	
	cout<<clean(l)<<endl;
	
	return 0;
}
