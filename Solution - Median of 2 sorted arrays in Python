import sys

def findMedianSortedArrays(nums1, m, nums2, n):
    # Ensure nums1 is the smaller array to prevent out-of-bounds in partition math
    if m > n:
        return findMedianSortedArrays(nums2, n, nums1, m)
        
    low = 0
    high = m
    total_left = (m + n + 1) // 2
    
    while low <= high:
        mid1 = (low + high) // 2
        mid2 = total_left - mid1
        
        # Values near the partition boundaries in nums1
        l1 = nums1[mid1 - 1] if mid1 > 0 else float('-inf')
        r1 = nums1[mid1] if mid1 < m else float('inf')
        
        # Values near the partition boundaries in nums2
        l2 = nums2[mid2 - 1] if mid2 > 0 else float('-inf')
        r2 = nums2[mid2] if mid2 < n else float('inf')
        
        # Valid partition check
        if l1 <= r2 and l2 <= r1:
            if (m + n) % 2 == 1:
                return float(max(l1, l2))
            else:
                return (max(l1, l2) + min(r1, r2)) / 2.0
        elif l1 > r2:
            # We took too many elements from nums1, shrink the upper bound
            high = mid1 - 1
        else:
            # We took too few elements from nums1, raise the lower bound
            low = mid1 + 1
            
    return 0.0

def solve():
    # Fast I/O to read and parse inputs efficiently
    input_data = sys.stdin.read().split()
    if not input_data:
        return
        
    iterator = iter(input_data)
    
    t = int(next(iterator))
    
    out = []
    for _ in range(t):
        m = int(next(iterator))
        n = int(next(iterator))
        
        # Safely parse both arrays even if m or n is 0
        nums1 = [int(next(iterator)) for _ in range(m)]
        nums2 = [int(next(iterator)) for _ in range(n)]
        
        median = findMedianSortedArrays(nums1, m, nums2, n)
        # Format the floating point precisely to 5 decimal places as required
        out.append(f"{median:.5f}")
        
    sys.stdout.write('\n'.join(out) + '\n')

if __name__ == '__main__':
    solve()
